//=============================================================================
// RIKeyPresets  (generated from ini files; do not edit by hand)
//  Classic = original Deus Ex defaults   (System\DefUser.ini, [Engine.Input])
//  Modern  = Fully Augmented Control Scheme v1.0 (its User.ini, [Extension.InputExt])
//  Classic keeps AE's extended command where the base action matches (e.g. mantling on Jump).
// Every key appears in both lists, so applying a preset fully replaces the layout.
//=============================================================================
class RIKeyPresets extends Object
	abstract;

