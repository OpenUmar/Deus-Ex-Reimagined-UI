//=============================================================================
// RIChoiceSubScale: Subtitle size (Settings > Interface), a slider in 5% steps
//=============================================================================
class RIChoiceSubScale extends RIChoiceScale;

defaultproperties
{
     Which=2
     numTicks=13
     startValue=80.000000
     endValue=140.000000
     defaultValue=100.000000
     HelpText="How large subtitles are drawn: what people say as you pass, and first-person conversations."
     actionText="Subtitle size"
}
